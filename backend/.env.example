# ============================================================
# IT Support Agent Backend - Environment Configuration
# ============================================================
# Copy this file to .env and update values as needed

# ============================================================
# MODEL CONFIGURATION
# ============================================================

# Fine-tuned model repository (Hugging Face)
# Default: oguzinyo/qwen2.5-3b-it-support-lora-v2
FINE_TUNED_MODEL_NAME=oguzinyo/qwen2.5-3b-it-support-lora-v2

# Maximum tokens to generate per request
# Higher values = longer responses but slower inference
MODEL_MAX_NEW_TOKENS=384

# Maximum inference time in seconds
# Model will stop generation if this time is exceeded
MODEL_MAX_GENERATION_SECONDS=120

# Load model from local files only (offline mode)
# Set to false to download models from Hugging Face Hub
MODEL_LOCAL_FILES_ONLY=false

# Merge LoRA adapters before inference (optional optimization)
# Disables by default for stability - enable only if you know what you're doing
# MERGE_LORA_ADAPTERS=false

# ============================================================
# API CONFIGURATION
# ============================================================

# API server host
API_HOST=127.0.0.1

# API server port
API_PORT=8000

# ============================================================
# DEVICE CONFIGURATION
# ============================================================

# GPU/CUDA device selection
# Leave empty for auto-detection, set to "cpu" to force CPU
# CUDA_VISIBLE_DEVICES=0

# ============================================================
# OPTIMIZATION & DEBUGGING
# ============================================================

# Windows OpenMP workaround (prevents duplicate libiomp5 error)
# Only needed on Windows
KMP_DUPLICATE_LIB_OK=TRUE

# Enable debug logging
# Set to DEBUG for verbose output
LOG_LEVEL=INFO

# ============================================================
# DATA STORAGE
# ============================================================

# Session data storage (local JSON file)
# Runtime sessions are stored here (not committed to git)
SESSION_DATA_PATH=./data/sessions.json

# ============================================================
# NOTES
# ============================================================
# 
# 1. GPU Requirements:
#    - NVIDIA GPU (T4 minimum for Colab, V100+ recommended)
#    - CUDA 11.8+ and cuDNN
#    - 6GB+ VRAM for FP16 inference
#
# 2. Memory Requirements:
#    - 8GB RAM minimum
#    - 16GB+ recommended
#    - Model cache: ~3GB
#
# 3. For Production:
#    - Use strong database (PostgreSQL)
#    - Enable monitoring and logging
#    - Set MODEL_LOCAL_FILES_ONLY=true after first run
#    - Use environment-specific configs
#
# 4. Troubleshooting:
#    - Meta tensor error: Check CUDA versions
#    - Out of memory: Reduce MODEL_MAX_NEW_TOKENS
#    - Slow inference: Enable CUDA and check GPU usage
#
